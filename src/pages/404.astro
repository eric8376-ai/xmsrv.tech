---
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
---

<Base title={`页面不存在｜${company.shortName}`} description="您访问的页面不存在。" path="/404" noindex>
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code serif" aria-hidden="true">404</p>
      <h1 class="not-found__title serif" id="not-found-title">这一页，深不见底。</h1>
      <p class="not-found__text">您访问的页面不存在，或已被移动。</p>
      <a class="btn btn--primary" href="/">返回首页</a>
    </div>
  </section>
</Base>
