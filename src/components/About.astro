---
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/company';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__head">
      <SectionHeading index={about.index} label={about.label} title={about.title} id="about-title" />
    </div>

    <div class="about__body">
      <p class="about__lead serif" data-reveal>{about.lead}</p>
      {about.paragraphs.map((paragraph) => <p class="about__para" data-reveal>{paragraph}</p>)}

      <dl class="fact-list" data-reveal>
        {
          about.facts.map((fact) => (
            <div class="fact-list__item">
              <dt>{fact.term}</dt>
              <dd>
                {fact.href ? (
                  <a href={fact.href} rel="noopener">{fact.detail}</a>
                ) : (
                  fact.detail
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
